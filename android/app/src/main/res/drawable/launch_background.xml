<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11's launch screen: the app's surface colour with the assembled
     flower in the middle. Android 12 and later use the animated one set in
     values-v31/styles.xml instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_flower_still"
        android:gravity="center" />
</layer-list>
