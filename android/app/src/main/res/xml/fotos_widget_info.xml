<?xml version="1.0" encoding="utf-8"?>
<!-- fotos' photo widget. Placing one opens WidgetSetupActivity first, and it
     can be set up again later from its long-press menu. Rebuilt daily so
     the shuffle starts afresh. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="86400000"
    android:initialLayout="@layout/fotos_widget_10s"
    android:previewLayout="@layout/fotos_widget_preview"
    android:description="@string/widget_description"
    android:configure="my.minned.fotos.widget.WidgetSetupActivity"
    android:widgetFeatures="reconfigurable" />
